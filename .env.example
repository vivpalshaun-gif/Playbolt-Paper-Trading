# =============================================================================
# Supabase (required for auth + portfolio)
# =============================================================================
# Prefer these on Vercel / production (browser-safe anon key):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional local aliases (same values). App falls back to these if NEXT_PUBLIC_*
# are unset:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key

# =============================================================================
# Vercel
# =============================================================================
# In the Vercel project → Settings → Environment Variables, add:
#   NEXT_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
# for Production (and Preview if you use preview deploys).
# Do NOT commit real keys. Copy this file to .env.local for local `npm run dev`.

# Optional Finnhub fallback if Yahoo fails (server-side only):
# FINNHUB_API_KEY=your-finnhub-key
